# ==============================================================================
# Pythos Production Environment Configuration Template
# ==============================================================================
# Copy to .env for local development or set in Railway environment settings.
# NEVER commit production secrets or service account keys to git.

# ── Server & Runtime Environment ──────────────────────────────────────────────
# NODE_ENV: Runtime environment ('production', 'development', 'test').
# In 'production', fails closed on missing secrets and disables development fallbacks.
NODE_ENV=production

# PORT: Local listening port for the Express API server.
# On Railway, this is provided automatically by the platform ($PORT).
PORT=3006

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins for browser clients.
# In production, defaults to 'https://pythos.lanzar.me,https://lanzar.me'.
CORS_ALLOWED_ORIGINS=https://pythos.lanzar.me,https://lanzar.me

# REQUEST_TIMEOUT_MS: Maximum request processing timeout in milliseconds.
REQUEST_TIMEOUT_MS=60000

# ── LANZAR ID Authentication & Security ───────────────────────────────────────
# LANZAR_ID_SECRET: MANDATORY in production.
# High-entropy secret (minimum 32 characters) used to sign and verify LANZAR ID
# HMAC-SHA256 session tokens. If unset in production, token generation and auth
# endpoints FAIL CLOSED immediately to protect student accounts.
LANZAR_ID_SECRET=

# ── AI Cost Guardrail & Spending Policy ───────────────────────────────────────
# PYTHOS_AI_BUDGET_MODE: AI spending safety control.
# Supported modes:
#   free_only     - Strictly $0/month cost guardrail (default & production safe).
#                   Only providers and models with explicit freeEligible=true can be invoked.
#                   Paid providers are rejected and fail closed.
#   paid_enabled  - Permits configured paid API providers (must be explicitly enabled by maintainer).
# If missing, malformed, or unrecognized, Pythos ALWAYS defaults to free_only.
PYTHOS_AI_BUDGET_MODE=free_only

# PYTHOS_AI_ENABLED: Emergency infrastructure kill switch (true/false).
# Defaults to true. If set to false, all external AI calls are immediately blocked
# without attempting upstream providers, returning a clean maintenance state.
PYTHOS_AI_ENABLED=true

# ── AI Providers (Hosted Vision & LLM) ────────────────────────────────────────
# PRIMARY_TEXT_PROVIDER: Primary LLM provider family ('groq', 'gemini', 'ollama'). Defaults to 'groq'.
PRIMARY_TEXT_PROVIDER=groq

# GROQ_API_KEY: API key for Groq reasoning & vision inference (REQUIRED for Groq activation).
# If unset or empty, Groq is marked unconfigured and provider policy falls back to alternative
# configured free providers (e.g. local Ollama, or Gemini if GEMINI_FREE_TIER=true).
# There is NO embedded fallback key in source code.
GROQ_API_KEY=

# GROQ_TEXT_MODEL: Text model identifier for Groq reasoning. Defaults to llama-3.3-70b-versatile.
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# GEMINI_API_KEY: (Optional) Google Gemini API key for backup vision and multimodal inference.
# If unset, Gemini is disabled and marked unconfigured.
GEMINI_API_KEY=

# GEMINI_TEXT_MODEL: Text model identifier for Gemini inference. Defaults to gemini-2.5-flash.
GEMINI_TEXT_MODEL=gemini-2.5-flash

# GEMINI_VISION_MODEL: Model identifier for Gemini vision requests. Defaults to gemini-2.5-flash.
GEMINI_VISION_MODEL=gemini-2.5-flash

# GEMINI_FREE_TIER: (true/false) OPERATOR CERTIFICATION / ASSERTION ONLY.
# IMPORTANT: This flag is NOT an automatic determination of Google's billing status.
# Google AI Studio / Gemini API does not expose a machine-readable endpoint to determine
# whether an API key is connected to a paid billing account or is strictly on the $0 rate-limited free tier.
# Therefore, Pythos fails closed:
#   - If GEMINI_FREE_TIER is unset, false, or anything other than 'true', Pythos treats Gemini
#     as potentially paid (freeEligible=false). Under PYTHOS_AI_BUDGET_MODE=free_only, Gemini
#     will NEVER be called under any circumstances, even as a fallback when Groq is unavailable.
#   - Setting GEMINI_FREE_TIER=true constitutes an EXPLICIT HUMAN OPERATOR CERTIFICATION that
#     the configured GEMINI_API_KEY is an unpaid, zero-cost Google AI Studio free-tier key.
GEMINI_FREE_TIER=false

# GEMINI_ENABLED: Feature flag / kill switch specifically for Gemini (true/false). Defaults to true.
GEMINI_ENABLED=true

# ── Local / Self-Hosted Inference (Ollama) ────────────────────────────────────
# OLLAMA_HOST: Host URL for self-hosted Ollama daemon.
OLLAMA_HOST=http://localhost:11434

# OLLAMA_MODEL: Default model tag for Ollama queries.
OLLAMA_MODEL=pythos:latest

# OLLAMA_API_KEY: Optional API key if running Ollama behind an authenticated reverse proxy.
OLLAMA_API_KEY=

# ── Computer Algebra System (CAS / SymPy IPC) ─────────────────────────────────
# PYTHON_BIN: Path to Python binary for SymPy calculus & algebraic verification daemon.
# If unset, auto-detected from environment PATH (python3, python).
PYTHON_BIN=

# CALCULUS_MAX_WORKERS: Maximum concurrent Python worker processes in the daemon pool.
# Defaults to 2 (safe for memory-constrained container environments).
CALCULUS_MAX_WORKERS=2

# ── Observability & Telemetry ─────────────────────────────────────────────────
# TELEMETRY_BUFFER_SIZE: Maximum in-memory telemetry events retained in ring buffer.
# Defaults to 500 (clamped between 50 and 5000).
TELEMETRY_BUFFER_SIZE=500

# ── Admin & Database Infrastructure ───────────────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON: Firebase Admin SDK service account key (JSON string, single line).
# Required for Firebase ID token verification and authoritative Firestore persistence.
# Obtain from: Firebase Console → Project Settings → Service accounts → Generate new private key.
# Store the entire JSON on a single line. NEVER commit this value to git.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ADMIN_API_KEY: Static API key fallback for server-to-server / CLI admin access.
# Accepts: Authorization: Bearer <key>  OR  X-Admin-Key: <key>
# If set, this is checked AFTER Firebase token verification fails.
# Leave blank to disable the fallback (Firebase-only mode).
ADMIN_API_KEY=
