PORT=3006
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=pythos:latest
OLLAMA_API_KEY=
REQUEST_TIMEOUT_MS=60000

# ── AI Cost Guardrail & Spending Policy ─────────────────────────────────────
# PYTHOS_AI_BUDGET_MODE: AI spending safety control.
# Supported modes:
#   free_only     - Strictly $0/month cost guardrail (default & production safe).
#                   Only providers and models with explicit freeEligible=true can be invoked.
#                   Paid providers are rejected and fail closed.
#   paid_enabled  - Permits configured paid API providers (must be explicitly enabled by Jon).
# If missing, malformed, or unrecognized, Pythos ALWAYS defaults to free_only.
PYTHOS_AI_BUDGET_MODE=free_only

# PYTHOS_AI_ENABLED: Emergency infrastructure kill switch (true/false).
# Defaults to true. If set to false, all external AI calls are immediately blocked
# without attempting upstream providers, returning a clean maintenance state.
PYTHOS_AI_ENABLED=true

# ── AI Providers (Hosted Vision & LLM) ──────────────────────────────────────
# GROQ_API_KEY: (Optional) Custom API key for Groq primary vision provider (Qwen 2.5-VL).
# If unset or empty, Pythos automatically falls back to its built-in free-tier Groq key.
GROQ_API_KEY=

# GEMINI_API_KEY: (Optional) Google Gemini API key for secondary backup vision inference.
# If unset, Gemini is disabled and marked unconfigured.
GEMINI_API_KEY=

# GEMINI_FREE_TIER: (true/false) OPERATOR CERTIFICATION / ASSERTION ONLY.
# IMPORTANT: This flag is NOT an automatic determination of Google's billing status.
# Google AI Studio / Gemini API does not expose a machine-readable endpoint to determine
# whether an API key is connected to a paid billing account or is strictly on the $0 rate-limited free tier.
# Therefore, Pythos fails closed:
#   - If GEMINI_FREE_TIER is unset, false, or anything other than 'true', Pythos treats Gemini
#     as potentially paid (freeEligible=false). Under PYTHOS_AI_BUDGET_MODE=free_only, Gemini
#     will NEVER be called under any circumstances, even as a fallback when Groq is unavailable.
#   - Setting GEMINI_FREE_TIER=true constitutes an EXPLICIT HUMAN OPERATOR CERTIFICATION that
#     the configured GEMINI_API_KEY is an unpaid, zero-cost Google AI Studio free-tier key.
GEMINI_FREE_TIER=false

# GEMINI_VISION_MODEL: Model identifier for Gemini vision requests. Defaults to gemini-2.5-flash.
GEMINI_VISION_MODEL=gemini-2.5-flash

# GEMINI_ENABLED: Feature flag / kill switch specifically for Gemini (true/false). Defaults to true.
GEMINI_ENABLED=true

# ── Admin Authentication (Phase 3B) ──────────────────────────────────────────
# Firebase Admin SDK service account key (JSON string, single line).
# Required for Firebase ID token verification in the browser-based admin console.
# Obtain from: Firebase Console → Project Settings → Service accounts → Generate new private key.
# Store the entire JSON on a single line. NEVER commit this value to git.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Static API key fallback for server-to-server / CLI admin access.
# Accepts: Authorization: Bearer <key>  OR  X-Admin-Key: <key>
# If set, this is checked AFTER Firebase token verification fails.
# Leave blank to disable the fallback (Firebase-only mode).
ADMIN_API_KEY=

# Bug reporting feature flag (true/false). Defaults to true.
ENABLE_BUG_REPORTING=true
